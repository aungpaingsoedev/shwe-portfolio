# Supabase API (Settings → API Keys → Legacy anon / service_role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma → Supabase Postgres (Settings → Database → Connection string)
# Transaction pooler (port 6543) for the app — keep connection_limit=1 with pgbouncer
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30
# Direct connection (port 5432) for migrations / prisma db push
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional overrides (defaults applied in src/lib/db.ts)
# PRISMA_CONNECTION_LIMIT=1
# PRISMA_POOL_TIMEOUT=30

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Docker (docker compose): use http://localhost:3003
NEXT_PUBLIC_RESUME_URL=/resume.pdf

# Contact email delivery (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
RESEND_TO_EMAIL=
